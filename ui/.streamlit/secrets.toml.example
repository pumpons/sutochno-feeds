# Скопируй в secrets.toml локально или вставь содержимое в streamlit.io → App settings → Secrets
# В streamlit.io используется TOML-формат тот же.

# Пароль, который команда вводит при входе в пульт.
app_password = "придумай-крепкий-пароль"

# GitHub Personal Access Token со scope: repo, workflow
# Создаётся на https://github.com/settings/tokens/new
github_token = "ghp_..."

# Репозиторий, где лежит код и сегменты
github_repo = "pumpons/sutochno-feeds"

# Ветка с актуальными сегментами
github_branch = "main"

# Имя workflow-файла для триггера пересборки
workflow_file = "daily.yml"

# URL опубликованных meta-файлов (с gh-pages)
meta_base_url = "https://pumpons.github.io/sutochno-feeds/meta"
